# Add build artifacts and dependencies to .gitignore
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyTorch
*.pth
*.pt

# Jupyter Notebook
.ipynb_checkpoints

# Environment
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs and databases
*.log
*.sqlite
logs/

# Data files (uncomment if you don't want to track data)
# data/raw/*
# data/processed/*

# Model checkpoints (except best model)
models/checkpoints/*
!models/checkpoints/.gitkeep

# Temporary files
tmp/
temp/
*.tmp

# OS files
.DS_Store
Thumbs.db
